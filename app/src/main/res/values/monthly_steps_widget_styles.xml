<?xml version="1.0" encoding="utf-8"?>
<resources>
    <dimen name="month_widget_cell_size">18dp</dimen>
    <dimen name="month_widget_cell_margin">1.5dp</dimen>
    <dimen name="month_widget_stats_height">34dp</dimen>
    <dimen name="month_widget_stat_value_top">13dp</dimen>
    <dimen name="month_widget_stat_label_size">9sp</dimen>
    <dimen name="month_widget_stat_value_size">16sp</dimen>

    <style name="MonthWidgetCell">
        <item name="android:layout_width">@dimen/month_widget_cell_size</item>
        <item name="android:layout_height">@dimen/month_widget_cell_size</item>
        <item name="android:layout_margin">@dimen/month_widget_cell_margin</item>
        <item name="android:visibility">invisible</item>
        <item name="android:scaleType">fitXY</item>
    </style>

    <style name="MonthWidgetStatImage">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">@dimen/month_widget_stats_height</item>
        <item name="android:layout_weight">1</item>
        <item name="android:scaleType">fitStart</item>
        <item name="android:tint">@color/month_widget_text</item>
        <item name="android:importantForAccessibility">yes</item>
    </style>
</resources>