<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/month_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="ltr"
    android:background="@drawable/month_steps_widget_background"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingHorizontal="6dp"
    android:paddingVertical="4dp">

    <RelativeLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <LinearLayout
            android:id="@+id/month_widget_grid"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <ImageView android:id="@+id/month_cell_00" style="@style/MonthWidgetCell" />
                <ImageView android:id="@+id/month_cell_01" style="@style/MonthWidgetCell" />
                <ImageView android:id="@+id/month_cell_02" style="@style/MonthWidgetCell" />
                <ImageView android:id="@+id/month_cell_03" style="@style/MonthWidgetCell" />
                <ImageView android:id="@+id/month_cell_04" style="@style/MonthWidgetCell" />
                <ImageView android:id="@+id/month_cell_05" style="@style/MonthWidgetCell" />
                <ImageView android:id="@+id/month_cell_06" style="@style/MonthWidgetCell" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <ImageView android:id="@+id/month_cell_07" style="@style/MonthWidgetCell" />
                <ImageView android:id="@+id/month_cell_08" style="@style/MonthWidgetCell" />
                <ImageView android:id="@+id/month_cell_09" style="@style/MonthWidgetCell" />
                <ImageView android:id="@+id/month_cell_10" style="@style/MonthWidgetCell" />
                <ImageView android:id="@+id/month_cell_11" style="@style/MonthWidgetCell" />
                <ImageView android:id="@+id/month_cell_12" style="@style/MonthWidgetCell" />
                <ImageView android:id="@+id/month_cell_13" style="@style/MonthWidgetCell" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <ImageView android:id="@+id/month_cell_14" style="@style/MonthWidgetCell" />
                <ImageView android:id="@+id/month_cell_15" style="@style/MonthWidgetCell" />
                <ImageView android:id="@+id/month_cell_16" style="@style/MonthWidgetCell" />
                <ImageView android:id="@+id/month_cell_17" style="@style/MonthWidgetCell" />
                <ImageView android:id="@+id/month_cell_18" style="@style/MonthWidgetCell" />
                <ImageView android:id="@+id/month_cell_19" style="@style/MonthWidgetCell" />
                <ImageView android:id="@+id/month_cell_20" style="@style/MonthWidgetCell" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <ImageView android:id="@+id/month_cell_21" style="@style/MonthWidgetCell" />
                <ImageView android:id="@+id/month_cell_22" style="@style/MonthWidgetCell" />
                <ImageView android:id="@+id/month_cell_23" style="@style/MonthWidgetCell" />
                <ImageView android:id="@+id/month_cell_24" style="@style/MonthWidgetCell" />
                <ImageView android:id="@+id/month_cell_25" style="@style/MonthWidgetCell" />
                <ImageView android:id="@+id/month_cell_26" style="@style/MonthWidgetCell" />
                <ImageView android:id="@+id/month_cell_27" style="@style/MonthWidgetCell" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <ImageView android:id="@+id/month_cell_28" style="@style/MonthWidgetCell" />
                <ImageView android:id="@+id/month_cell_29" style="@style/MonthWidgetCell" />
                <ImageView android:id="@+id/month_cell_30" style="@style/MonthWidgetCell" />
                <ImageView android:id="@+id/month_cell_31" style="@style/MonthWidgetCell" />
                <ImageView android:id="@+id/month_cell_32" style="@style/MonthWidgetCell" />
                <ImageView android:id="@+id/month_cell_33" style="@style/MonthWidgetCell" />
                <ImageView android:id="@+id/month_cell_34" style="@style/MonthWidgetCell" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <ImageView android:id="@+id/month_cell_35" style="@style/MonthWidgetCell" />
                <ImageView android:id="@+id/month_cell_36" style="@style/MonthWidgetCell" />
                <ImageView android:id="@+id/month_cell_37" style="@style/MonthWidgetCell" />
                <ImageView android:id="@+id/month_cell_38" style="@style/MonthWidgetCell" />
                <ImageView android:id="@+id/month_cell_39" style="@style/MonthWidgetCell" />
                <ImageView android:id="@+id/month_cell_40" style="@style/MonthWidgetCell" />
                <ImageView android:id="@+id/month_cell_41" style="@style/MonthWidgetCell" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/month_widget_grid"
            android:layout_alignStart="@id/month_widget_grid"
            android:layout_alignEnd="@id/month_widget_grid"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/month_widget_cell_margin">

            <ImageView
                android:id="@+id/month_best_value"
                style="@style/MonthWidgetStatImage" />

            <ImageView
                android:id="@+id/month_avg_value"
                style="@style/MonthWidgetStatImage" />
        </LinearLayout>
    </RelativeLayout>
</LinearLayout>